generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Card {
  id              String   @id
  order           Int      @unique
  name            String
  subtitle        String
  category        String
  group           String
  tags            Json
  uprightMeaning  String
  reversedMeaning String
  aiKeywords      Json
  stageLine       String
  description     String
  imageElements   Json
  visualStyle     String
  accentColor     String
  imageUrl        String
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Reading {
  id             String   @id @default(cuid())
  question       String
  draws          Json
  interpretation Json?
  unlockStatus   String   @default("locked")
  createdAt      DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  apiKey    String   @unique
  createdAt DateTime @default(now())
}

model AiConfig {
  id                 String   @id @default("default")
  baseUrl            String
  apiKey             String
  modelId            String
  systemPrompt       String   @default("")
  userPromptTemplate String   @default("")
  enabled            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
